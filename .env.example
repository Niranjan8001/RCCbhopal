# Copy this file to .env.local and fill in real values.
# Vars WITHOUT the NEXT_PUBLIC_ prefix are server-only and never reach the browser bundle.

# --- Google Maps (client-side map on the Site Visits section) ---
# Referrer-restricted key is fine/expected here — it's exposed to the browser by design.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Google Place ID for RCC's Business Profile (not secret, just an identifier) ---
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# --- Anthropic (AI chat widget, /api/chat) ---
ANTHROPIC_API_KEY=

# --- Google Places API key for fetching real reviews server-side (/api/reviews) ---
# Server-only. Needs "Places API" enabled in Google Cloud Console. Do NOT restrict this
# key to HTTP referrers (it's called from the server, not the browser) — restrict by IP
# or leave unrestricted-but-API-scoped instead.
GOOGLE_PLACES_API_KEY=

# --- Resend (contact form email delivery, /api/contact) ---
RESEND_API_KEY=
# Inbox that receives contact-form submissions. Defaults to help@rccbhopal.in if unset.
CONTACT_TO_EMAIL=

# --- Google Analytics (optional) ---
# Leave unset to disable analytics entirely — nothing loads or fires without this.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
